{
  "name": "reservation-frontend",
  "version": "0.1.0",
  "proxy": "http://localhost:3000",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@gsap/react": "^2.1.2",
    "axios": "^1.10.0",
    "bootstrap": "^5.3.3",
    "dayjs": "^1.11.13",
    "gsap": "^3.15.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "recharts": "^3.1.0",
    "web-vitals": "^4.2.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "export:word-bridge-bank": "node scripts/exportWordBridgeBank.mjs",
    "export:word-bridge-docx": "node scripts/exportWordBridgeBankDocx.mjs",
    "audit:cefr-banks": "node scripts/auditCefrWordBanks.mjs",
    "build:vocabulary-bank": "node scripts/buildCanonicalVocabularyBank.mjs",
    "build:micro-learning-banks": "node scripts/buildMicroLearningQuestionBanks.mjs",
