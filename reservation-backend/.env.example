# 日誌級別設定
# 可選值：DEBUG, INFO, WARN, ERROR, NONE
# DEBUG: 顯示所有日誌（包括詳細調試資訊）
# INFO: 顯示一般資訊、警告和錯誤（推薦生產環境）
# WARN: 只顯示警告和錯誤
# ERROR: 只顯示錯誤
# NONE: 不輸出任何日誌
LOG_LEVEL=INFO

# SystemLog（DB）減量：僅影響 system_logs 表，不影響 console / 管理端記憶體近期摘要
# 成功 GET/HEAD 依機率寫入；錯誤（status≥）、慢請求、/api/admin、POST/PUT/PATCH/DELETE 仍全寫
# 生產可設 0.1～0.25；開發可設 1
SYSTEM_LOG_GET_SAMPLE_RATE=1
# 超過此耗時（毫秒）一律寫入
SYSTEM_LOG_SLOW_MS=4000
# status 大於等於此值一律寫入（預設 400）
SYSTEM_LOG_ALWAYS_STATUS_MIN=400
# 可選：逗號分隔路徑前綴，成功 GET 幾乎不寫（除非錯誤／慢／管理端），適合輪詢 API
# SYSTEM_LOG_SKIP_PATH_PREFIXES=/api/example/poll
# 上列前綴內成功 GET 的額外抽樣率（0＝全跳過、1＝等同一般 GET 規則）
# SYSTEM_LOG_SKIP_PREFIX_GET_SAMPLE_RATE=0

# 稽核：登入失敗合併寫入間隔（毫秒）。0＝每筆立即寫；預設 5000 內同 IP 合併一筆
# AUDIT_LOGIN_FAILURE_AGGREGATE_MS=5000

# 登入：per-account cooldown（記憶體；程序重啟清空）
LOGIN_ACCOUNT_COOLDOWN_ENABLED=true
LOGIN_ACCOUNT_COOLDOWN_THRESHOLD=5
LOGIN_ACCOUNT_COOLDOWN_MINUTES=30

# 日誌保留（scripts/cleanup-logs.js；預設 dry-run，需 --apply 才刪除／匯出）
SYSTEM_LOG_RETENTION_DAYS=180
EMAIL_LOG_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
# keep=不處理 audit；archive=匯出 JSONL（無 DB archived 欄位）；delete=刪除超過保留期（需審慎）
AUDIT_LOG_CLEANUP_MODE=keep
# AUDIT_LOG_DELETE_AFTER_ARCHIVE=false

# 備份健康檢查（npm run backup:health；對應 Level 1 本機路徑見 scripts/backup-db.bat）
BACKUP_HEALTH_DIR=D:\EEARS_backup\local
BACKUP_HEALTH_MAX_AGE_HOURS=36
BACKUP_HEALTH_PATTERN=.sql.gz

# Learning Journey v3 read model（Phase 6 起預設 true；設為 false 可 rollback 至 legacy）
ENABLE_LEARNING_JOURNEY_V3_READ_MODEL=true
# 達此學期起，legacy 英檢寫入會被擋下，必須走 Learning Journey canonical sync/import
LEARNING_JOURNEY_CANONICAL_REQUIRED_FROM_SEMESTER=115-1

# EWL（英文寫作工坊）外部 API（可選；未設則使用預設正式網址）
# EWL_API_BASE_URL=https://emicenter.siwan.nsysu.edu.tw/EWL/StudentApi
# EWL_API_PAGE_SIZE=100

# 英語學習歷程中心 legacy 英檢資料（可選）
# ENABLE_ENGLISH_TEST_TRACKING=true
# ENGLISH_TEST_TRACKING_IMPORT_OVERWRITE_ENROLLMENT=false
# ENGLISH_TEST_TRACKING_BEST_TIEBREAKER=cefr,rawScore,testDate,attemptId

# 培力英檢報名信箱驗證碼（預設啟用；設為 false 可暫時關閉）
# ENGLISH_TEST_EMAIL_VERIFICATION_ENABLED=true

# --- 安全（P0/P4）：JWT、CORS、HTTP 防護 ---
# 正式環境必填；至少 32 字元；請自行產生隨機字串，勿提交真實 secret 到版本庫
JWT_SECRET=replace-with-a-long-random-secret
# 逗號分隔的瀏覽器來源白名單；正式環境必填。未帶 Origin 的請求（curl、同源）仍會放行
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JSON / urlencoded body 大小上限（檔案上傳走 multer，不受此限制）
REQUEST_BODY_LIMIT=1mb

# 全域 API rate limit（不取代 login IP limit 與 per-account cooldown）
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000

# 英語實踐歷程護照（學生端）專用限流；全站限流已略過此路徑
# ELP_READ_RATE_LIMIT_MAX=300
# ELP_READ_RATE_LIMIT_WINDOW_MS=600000
# ELP_WRITE_RATE_LIMIT_MAX=40

# IIS / 反向代理後設 1，讓 req.ip 反映 X-Forwarded-For；直連 Node 勿開
# TRUST_PROXY=1

# accessVersion：正式環境一律強制 JWT 與 DB 一致；開發／測試預設關閉，設為 true 可模擬 stale token
# ACCESS_VERSION_CHECK_ENABLED=true
# 開發時僅在 ACCESS_VERSION_CHECK_ENABLED=true 時生效：路徑／角色白名單（逗號分隔）
# ACCESS_VERSION_ENFORCE_PATH_PREFIXES=/api/admin
# ACCESS_VERSION_ENFORCE_ROLES=
